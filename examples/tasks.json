// Copy into your Shopware or Symfony project as .zed/tasks.json, together with
// sw-action.py. Run via `task: spawn`, or bind keys (see keymap.json).
//
// These cover shopware-lsp generator features that cannot be LSP code actions
// in Zed: the server returns text or a WorkspaceEdit and expects the client to
// run a picker and write the result. The task does both.
[
  {
    "label": "Shopware: add Twig extends",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "twig-extends",
      "$ZED_FILE",
      "$ZED_ROW"
    ],
    // The script reads from disk, so flush the buffer first.
    "save": "current",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Shopware: add Twig blocks",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "twig-blocks",
      "$ZED_FILE",
      "$ZED_ROW"
    ],
    "save": "current",
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Shopware: generate form fields",
    "command": "python3",
    // Rewrites the whole FormType, so no row argument.
    "args": ["$ZED_WORKTREE_ROOT/.zed/sw-action.py", "form-fields", "$ZED_FILE"],
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Shopware: generate Twig form rows",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "twig-form-fields",
      "$ZED_FILE",
      "$ZED_ROW"
    ],
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Shopware: scaffold (preview)",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "scaffold",
      "$ZED_DIRNAME",
      "--print"
    ],
    "reveal": "always"
  },
  {
    "label": "Shopware: scaffold (write)",
    "command": "python3",
    "args": ["$ZED_WORKTREE_ROOT/.zed/sw-action.py", "scaffold", "$ZED_DIRNAME"],
    "reveal": "always"
  },
  {
    "label": "Shopware: create storefront snippet",
    "command": "python3",
    "args": ["$ZED_WORKTREE_ROOT/.zed/sw-action.py", "snippet", "$ZED_FILE"],
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Shopware: create admin snippet",
    "command": "python3",
    "args": ["$ZED_WORKTREE_ROOT/.zed/sw-action.py", "snippet-admin", "$ZED_FILE"],
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Shopware: override storefront block",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "twig-extend-block",
      "$ZED_FILE",
      "$ZED_ROW"
    ],
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Shopware: override admin block",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "admin-twig-override",
      "$ZED_FILE",
      "$ZED_ROW"
    ],
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Shopware: Twig block diff",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "twig-block-diff",
      "$ZED_FILE",
      "$ZED_ROW"
    ],
    "reveal": "always"
  },
  {
    "label": "Shopware: service definition for this class",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "service-definition",
      "$ZED_FILE"
    ],
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Shopware: create compiler pass",
    "command": "python3",
    "args": ["$ZED_WORKTREE_ROOT/.zed/sw-action.py", "compiler-pass"],
    "reveal": "always"
  },
  {
    // Only offered when text is selected: Zed filters out tasks whose
    // variables are unset.
    "label": "Shopware: extract Twig translation",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "translation-extract",
      "$ZED_FILE",
      "$ZED_ROW",
      "--text",
      "$ZED_SELECTED_TEXT"
    ],
    "save": "current",
    "reveal": "always"
  },
  {
    // Through sw-action.py rather than calling shopware-lsp directly: after the
    // documented install the only copy is inside Zed's extension directory and
    // is not on PATH, so a direct call fails.
    "label": "Shopware: diagnostics for this file",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "run",
      "--",
      "-root",
      "$ZED_WORKTREE_ROOT",
      "check",
      "$ZED_FILE"
    ],
    "reveal": "always"
  },
  {
    "label": "Shopware: browse Symfony routes",
    "command": "python3",
    "args": [
      "$ZED_WORKTREE_ROOT/.zed/sw-action.py",
      "run",
      "--",
      "-root",
      "$ZED_WORKTREE_ROOT",
      "execute",
      "shopware/symfony/analytics/routes"
    ],
    "reveal": "always"
  }
]
